# PRSmith v2 Production Environment Configuration Template

# ── General Server & Environment ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate-a-secure-random-secret-key-for-jwt-signing

# ── GitHub Integration & OAuth ──────────────────────────────────────────────────
# GitHub OAuth 2.0 (for dashboard user login & repo discovery)
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret
GITHUB_OAUTH_SCOPES="read:user user:email read:org"
FRONTEND_URL=http://localhost:3000

# Token Encryption at Rest (Fernet key - REQUIRED: generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GITHUB_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Personal Access Token (PAT) - optional dev fallback (disabled by default)
GITHUB_PAT=github_pat_your_token_here
ENABLE_PAT_FALLBACK=false

# GitHub App Integration (for webhooks and automated PR operations)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=prsmith.private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ── Database & Redis Queues ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prsmith
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/prsmith
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── LLM Provider Architecture ─────────────────────────────────────────────────
# Active provider selection: openai | gemini | anthropic | deepseek | qwen | custom
LLM_PROVIDER=openai

# 1. OpenAI (Native)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 2. Google Gemini (Native)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FAST_MODEL=gemini-1.5-flash

# 3. Anthropic Claude (Native)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# 4. DeepSeek (OpenAI-Compatible Gateway)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 5. Qwen / Alibaba DashScope (OpenAI-Compatible Gateway)
QWEN_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-turbo
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 6. Custom / Local Gateway (Ollama, vLLM, OpenRouter, Groq, Together)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_MODEL=default
CUSTOM_FAST_MODEL=default
ALLOW_LOCAL_CUSTOM_ENDPOINTS=false

# ── Token Budget & Cost Safety Limits ─────────────────────────────────────────
MAX_COST_USD=5.0
MAX_TOKEN_BUDGET=16000
MAX_MODEL_CALLS=15

# ── Sandbox Execution (Docker) ────────────────────────────────────────────────
SANDBOX_DOCKER_IMAGE=prsmith-sandbox:latest
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_NETWORK_ENABLED=false
SANDBOX_USER=sandboxuser

# ── Repair Policy Limits ──────────────────────────────────────────────────────
MAX_REPAIR_ITERATIONS=5
MAX_REPAIR_TIME_SECONDS=600
MAX_FILES_CHANGED=5
MAX_LINES_ADDED=200
MAX_LINES_DELETED=200
MAX_PATCH_BYTES=32768

# ── Risk Gate Thresholds ──────────────────────────────────────────────────────
PR_RISK_HIGH_THRESHOLD=70
PR_RISK_CRITICAL_THRESHOLD=90
